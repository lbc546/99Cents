# 99Cents Bot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Polymarket wallet private key (required for live trading)
POLYMARKET_PRIVATE_KEY=

# Polygon RPC URL (optional override — default: https://polygon-rpc.com)
# For production, use a dedicated provider (Alchemy, Infura, QuickNode)
POLYGON_RPC_URL=

# CLOB API credentials (run: python setup_credentials.py to derive these)
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# Polymarket proxy wallet address (find on your Polymarket profile page)
POLYMARKET_PROXY_ADDRESS=
